# Salin file ini jadi ".env" dan isi dengan API key kamu sendiri.
# JANGAN taruh .env di git / kirim ke orang lain.

PORT=3000

# Daftar di https://developer.spotify.com/dashboard untuk dapat ini
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Daftar di https://console.cloud.google.com (aktifkan "YouTube Data API v3")
YOUTUBE_API_KEY=
